{
  "name": "xbed",
  "private": true,
  "version": "1.0.0",
  "description": "XBed 玄剑起床战争赛事平台（S1）",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:api": "pnpm --filter @xbed/api dev",
    "dev:web": "pnpm --filter @xbed/web dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @xbed/api test",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @xbed/api db:migrate",
    "db:seed": "pnpm --filter @xbed/api db:seed"
  }
}
