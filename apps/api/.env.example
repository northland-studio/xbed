# ===== XBed API 环境变量 =====
NODE_ENV=production
PORT=3939
PUBLIC_ORIGIN=https://xbed.xuanjian.top
# 允许的额外跨源写操作 Origin（逗号分隔，可选；开发默认放行 5173）
EXTRA_ORIGINS=

# SQLite 与文件目录（生产：/var/www/xbed/data）
DB_FILE=./data/xbed.db
FILES_DIR=./data/files

# 会话与加密（各 64 位 hex，生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"）
SESSION_SECRET=
ENCRYPTION_KEY=
SESSION_TTL_DAYS=7
# 留空时生产自动 true
COOKIE_SECURE=
TRUST_PROXY=false

# 玄剑 OAuth（在玄剑官网后台注册 xbed 应用后填入）
XUANJIAN_PROVIDER_URL=https://www.xuanjian.top
XUANJIAN_CLIENT_ID=xbed
XUANJIAN_CLIENT_SECRET=
XUANJIAN_REDIRECT_URI=https://xbed.xuanjian.top/api/auth/callback
XUANJIAN_SCOPE=read:user read:member

# 开发用模拟登录（仅 NODE_ENV!=production 且 OAUTH_MOCK=1 时启用）
OAUTH_MOCK=0

# SMTP（可选，未配置则验证码打印到日志；管理后台配置优先）
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@xuanjian.top
SMTP_PASS=
SMTP_FROM_NAME=XBed 赛事平台
SMTP_FROM_EMAIL=

# 上传限制（MB，可被 system_settings 覆盖）
UPLOAD_MAX_LOG_MB=20
UPLOAD_MAX_MCPR_MB=300

# 业务期限（可被 system_settings 覆盖）
EVIDENCE_DEADLINE_MINUTES=60
APPEAL_DEADLINE_HOURS=48
